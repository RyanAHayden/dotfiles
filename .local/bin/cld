#!/usr/bin/env bash
# ponytail: no CLI flag skips the workspace trust dialog, so pre-mark $PWD trusted in ~/.claude.json.
# Ceiling: tiny race if another claude session rewrites the file at the same instant.
f=~/.claude.json
if [[ -f $f ]] && ! jq -e --arg d "$PWD" '.projects[$d].hasTrustDialogAccepted' "$f" >/dev/null; then
  tmp=$(mktemp "$f.XXXXXX") && jq --arg d "$PWD" '.projects[$d].hasTrustDialogAccepted = true' "$f" >"$tmp" \
    && chmod --reference="$f" "$tmp" && mv "$tmp" "$f" || rm -f "$tmp"
fi
exec claude --dangerously-skip-permissions ${*:+"$*"}
