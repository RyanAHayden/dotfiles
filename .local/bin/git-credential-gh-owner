#!/bin/sh
# git credential helper: use the gh login named like the repo's owner (github.com/<owner>/...),
# so pushes never depend on which gh account is active. Owners with no matching login fall back to
# the active one. Needs credential.useHttpPath so git passes the path.
in=$(cat)
owner=$(printf '%s\n' "$in" | sed -n 's|^path=\([^/]*\)/.*|\1|p')
login=$(gh auth status -h github.com 2>/dev/null | sed -n 's/.* account \([^ ]*\).*/\1/p' | grep -ixF -- "$owner" | head -1)
if [ "$1" = get ] && [ -n "$login" ] && token=$(gh auth token -h github.com -u "$login" 2>/dev/null); then
  printf 'username=%s\npassword=%s\n' "$login" "$token"
else
  printf '%s\n' "$in" | gh auth git-credential "$@"
fi
