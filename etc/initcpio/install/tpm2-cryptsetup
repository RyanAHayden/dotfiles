#!/usr/bin/env bash
build() {
    add_binary "/usr/lib/cryptsetup/libcryptsetup-token-systemd-tpm2.so"
    local lib
    for lib in /usr/lib/libtss2-*.so.0; do
        add_binary "$lib"
    done
    add_runscript
}

help() {
    cat <<HELPEOF
This hook adds the systemd-tpm2 cryptsetup token plugin and the tpm2-tss
libraries it dlopen()s, and a runtime script that silently tries a
--token-only unlock before the 'encrypt' hook runs. If the TPM unlocks the
volume, 'encrypt' sees /dev/mapper/<name> already exists and skips its own
passphrase prompt (including the Plymouth one). If the TPM attempt fails,
'encrypt' runs normally and asks for the passphrase as usual.
HELPEOF
}
