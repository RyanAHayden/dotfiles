#!/bin/bash
# Sunshine prep-cmd: stream a headless output sized to the Moonlight client instead of DP-1, so a 16:10 Mac
# fills edge to edge. Usage: stream-display start|stop. start reads SUNSHINE_CLIENT_WIDTH/HEIGHT/FPS.
# DP-1 is turned off meanwhile so every workspace moves onto the stream; stop (also run when Sunshine starts,
# in case a session died without its undo) turns it back on and the workspaces return.
export HYPRLAND_INSTANCE_SIGNATURE=${HYPRLAND_INSTANCE_SIGNATURE:-$(ls -t "$XDG_RUNTIME_DIR/hypr" | head -1)}
name=STREAM

case "$1" in
  start)
    w=${SUNSHINE_CLIENT_WIDTH:-2560} h=${SUNSHINE_CLIENT_HEIGHT:-1600} fps=${SUNSHINE_CLIENT_FPS:-60}
    hyprctl monitors all | grep -q "^Monitor $name " || hyprctl output create headless "$name" >/dev/null
    # scale 1.6 = about the Mac's own default looks-like size on a 2560x1600 stream
    hyprctl eval "hl.monitor({ output = \"$name\", mode = \"${w}x${h}@${fps}\", position = \"auto\", scale = 1.6 })" >/dev/null
    hyprctl eval "hl.monitor({ output = \"DP-1\", disabled = true })" >/dev/null
    ;;
  stop)
    hyprctl eval "hl.config({ cursor = { invisible = false } })" >/dev/null
    hyprctl monitors all | grep -q "^Monitor $name " || exit 0
    # reload re-applies monitors.lua, which turns DP-1 back on at its usual scale
    hyprctl reload >/dev/null
    sleep 1
    hyprctl output remove "$name" >/dev/null
    ;;
  *) echo "usage: stream-display start|stop" >&2; exit 1 ;;
esac
