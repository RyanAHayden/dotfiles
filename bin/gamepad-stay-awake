#!/usr/bin/env python3
# Hold Omarchy's stay-awake while any gamepad is in use; release after QUIET seconds.
# Hyprland's idle tracking ignores gamepads, so the screensaver/lock fired mid-game.
# The idle service watches FLAG, so touching/removing it is the whole interface.
# Ours when FLAG holds MARK; a manual toggle (touch) leaves it empty, so we never remove the user's.
import os, select, signal, sys, time
import evdev
from evdev import ecodes as e

QUIET = 60       # seconds of no controller input before idle is allowed again
DEADZONE = 0.15  # fraction of axis range; ignores stick drift
POLL = 2         # seconds between /dev/input hotplug checks
FLAG = os.path.expanduser("~/.local/state/omarchy/indicators/stay-awake")
MARK = "gamepad"  # bar-status.sh awake reads this too


def moved(etype, value, axis):
    """axis = (min, max, rest) for EV_ABS, None otherwise. rest = value at open
    (sticks rest centered, triggers rest at min)."""
    if etype == e.EV_KEY:
        return True
    if etype != e.EV_ABS or axis is None:
        return False
    lo, hi, rest = axis
    span = hi - lo
    if span <= 2:  # d-pad hats: -1/0/1
        return value != 0
    return abs(value - rest) > span * DEADZONE


def is_uinput(syspath):
    return "/devices/virtual/input/" in syspath


def ours():
    try:
        with open(FLAG) as f:
            return f.read().strip() == MARK
    except FileNotFoundError:
        return False


def hold():
    """Create FLAG only if absent (O_EXCL: can't clobber a manual set). True if we now hold it."""
    os.makedirs(os.path.dirname(FLAG), exist_ok=True)
    try:
        fd = os.open(FLAG, os.O_WRONLY | os.O_CREAT | os.O_EXCL)
    except FileExistsError:
        return False
    os.write(fd, MARK.encode())
    os.close(fd)
    return True


def release():
    if ours():  # never remove a stay-awake the user set
        try:
            os.unlink(FLAG)
        except FileNotFoundError:
            pass


def main():
    release()  # clean up after a previous run that was killed while holding
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    signal.signal(signal.SIGHUP, lambda *_: sys.exit(0))

    pads = {}      # fd -> (device, {abs code: (min, max)})
    seen = set()   # every /dev/input path already examined (pad or not)
    # -inf, not 0: monotonic counts from boot, so 0 looked like "pad used just now" right after login
    last, held, next_scan = float("-inf"), False, 0.0
    vetoed = False  # user switched it off mid-play; don't retake it until the pad goes quiet
    try:
        while True:
            now = time.monotonic()
            if now >= next_scan:  # open only new devices; forget vanished ones
                paths = set(evdev.list_devices(writable=False))  # pads can be read-only (mask r--)
                seen &= paths
                for path in paths - seen:
                    seen.add(path)
                    try:
                        d = evdev.InputDevice(path)
                    except OSError:
                        continue
                    caps = d.capabilities(absinfo=True)
                    # Skip uinput vpads (bots/tools), except Steam Input's: it only moves when a person does, and a
                    # Steam Controller/Deck has no other node while Steam owns it. 0x28de = Valve.
                    # uinput lives under /devices/virtual/input/; Bluetooth pads are uhid (/devices/virtual/misc/uhid/) and real.
                    virtual = is_uinput(os.path.realpath(f"/sys/class/input/{os.path.basename(path)}"))
                    virtual = virtual and d.info.vendor != 0x28DE
                    if e.BTN_SOUTH in caps.get(e.EV_KEY, []) and not virtual:
                        pads[d.fd] = (d, {c: (i.min, i.max, i.value) for c, i in caps.get(e.EV_ABS, [])})
                    else:
                        d.close()
                next_scan = now + POLL

            for fd in select.select(list(pads), [], [], POLL)[0]:
                d, axes = pads[fd]
                try:
                    if any(moved(ev.type, ev.value, axes.get(ev.code)) for ev in d.read()):
                        last = time.monotonic()
                except OSError:  # unplugged; next scan reopens it if it comes back
                    del pads[fd]
                    seen.discard(d.path)
                    d.close()

            if held and not ours():
                held = False  # user toggled it off (or off then on, making it theirs)
                vetoed = not os.path.exists(FLAG)
            active = time.monotonic() - last < QUIET
            if not active:
                vetoed = False
            if active and not held and not vetoed:
                held = hold()
            elif not active and held:
                release()
                held = False
    finally:
        if held:
            release()


if __name__ == "__main__":
    if sys.argv[1:] == ["--test"]:
        stick, hat, trig = (-32768, 32767, 0), (-1, 1, 0), (0, 255, 0)
        assert moved(e.EV_KEY, 1, None)
        assert not moved(e.EV_ABS, 1200, stick)       # drift
        assert moved(e.EV_ABS, 20000, stick)
        assert not moved(e.EV_ABS, 5, trig) and moved(e.EV_ABS, 200, trig)
        assert not moved(e.EV_ABS, 0, hat) and moved(e.EV_ABS, -1, hat)
        assert not moved(e.EV_SYN, 0, None)
        assert is_uinput("/sys/devices/virtual/input/input39/event20")
        assert not is_uinput("/sys/devices/virtual/misc/uhid/0005:045E:02E0.001C/input/input49/event21")
        import tempfile
        FLAG = os.path.join(tempfile.mkdtemp(), "stay-awake")
        assert hold() and ours() and not hold()   # second hold doesn't double-claim
        release(); assert not os.path.exists(FLAG)
        open(FLAG, "w").close()                   # manual set
        assert not hold() and not ours()
        release(); assert os.path.exists(FLAG)    # manual survives our release
        print("ok")
    else:
        main()
