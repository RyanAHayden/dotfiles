#!/usr/bin/env python3
# Hold Omarchy's stay-awake while any gamepad is in use; release after QUIET seconds.
# Hyprland's idle tracking ignores gamepads, so the screensaver/lock fired mid-game.
import os, select, sys, time
import evdev
from evdev import ecodes as e

QUIET = 60      # seconds of no controller input before idle is allowed again
DEADZONE = 0.15  # fraction of axis range; ignores stick drift
FLAG = os.path.expanduser("~/.local/state/omarchy/indicators/stay-awake")

def gamepads():
    pads = {}
    for path in evdev.list_devices():
        try:
            d = evdev.InputDevice(path)
            if e.BTN_SOUTH in d.capabilities().get(e.EV_KEY, []):
                pads[d.fd] = d
            else:
                d.close()
        except OSError:
            pass
    return pads

def moved(dev, ev):
    if ev.type == e.EV_KEY:
        return True
    if ev.type != e.EV_ABS:
        return False
    info = dev.absinfo(ev.code)
    span = info.max - info.min
    if span <= 2:  # d-pad hats
        return ev.value != 0
    center = (info.max + info.min) / 2
    return abs(ev.value - center) > span * DEADZONE

held = False  # True only if we created the flag, so a manual stay-awake is left alone
last = 0.0
pads, rescan = {}, 0.0
while True:
    now = time.monotonic()
    if now >= rescan:  # pick up hotplugged / bluetooth controllers
        for d in pads.values():
            d.close()
        pads, rescan = gamepads(), now + 5
    ready = select.select(list(pads), [], [], 1)[0] if pads else (time.sleep(1) or [])
    for fd in ready:
        dev = pads[fd]
        try:
            if any(moved(dev, ev) for ev in dev.read()):
                last = time.monotonic()
        except OSError:  # unplugged
            rescan = 0
    active = time.monotonic() - last < QUIET
    if active and not held and not os.path.exists(FLAG):
        os.system("omarchy-toggle-idle stay-awake >/dev/null")
        held = True
    elif not active and held:
        os.system("omarchy-toggle-idle allow-idle >/dev/null")
        held = False
