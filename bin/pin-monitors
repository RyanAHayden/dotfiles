#!/bin/bash
# Pin every currently connected DP monitor as "connected" until the next reboot.
# Some monitors (LG UltraGear+ on DP) drop hotplug while DPMS-asleep; Hyprland then
# sees zero monitors and crashes when a window maps. Forcing the connector on with
# its current EDID keeps it present. Runtime-only: nothing persists across reboots.
# Run as root (pin-monitors.service does it at boot). `pin-monitors off` unpins.
# Only DP connectors: the TV (HDMI) should still look unplugged when it's off.
# After switching the LG's dual mode (4K@240 <-> 1080p@480) the pinned EDID is stale, re-pin with:
#   sudo systemctl restart pin-monitors   (unpins, waits for DP-1, pins the new EDID)
# The service runs a root-owned copy: sudo install -m755 ~/dotfiles/bin/pin-monitors /usr/local/bin/
set -eu

for c in /sys/class/drm/card*-*; do
  name=${c##*/}; conn=${name#*-}
  [[ $conn == Writeback* ]] && continue
  dbg=/sys/kernel/debug/dri/$(basename "$(readlink -f "$c/device/device")")/$conn
  if [[ ${1:-} == off ]]; then
    echo detect > "$c/status"
    [[ -e $dbg/edid_override ]] && printf reset > "$dbg/edid_override"  # kernel rejects a trailing newline
    continue
  fi
  [[ $conn == DP-* && $(cat "$c/status") == connected ]] || continue
  cat "$c/edid" > "$dbg/edid_override"
  echo on > "$c/status"
  echo "pinned $name"
done
