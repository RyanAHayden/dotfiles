#!/usr/bin/env bash
# steam-rescale SCALE: keep Steam's UI the same size as the rest of the desktop across the LG dual
# modes (4K scale 1.6 / 1080p scale 1). Called by monitors.lua's dual-mode hook on every DP-1 change.
# Steam only reads its UI scale at startup, so it's never restarted on its own (that would kill
# downloads); new launches get the new scale, and a running Steam gets a click-to-restart notification.
# steam-rescale --restart SCALE: the click. Refuses while a game is running.
[ "$1" = --restart ] && restart=1 && shift
s=$1
systemctl --user set-environment STEAM_FORCE_DESKTOPUI_SCALING="$s"
pid=$(pgrep -x steam | head -1)
[ -n "$pid" ] || exit 0
cur=$(tr '\0' '\n' <"/proc/$pid/environ" | sed -n 's/^STEAM_FORCE_DESKTOPUI_SCALING=//p')
[ "$cur" = "$s" ] && exit 0
if [ -z "$restart" ]; then
	omarchy-notification-send -t 15000 "Steam UI scale changed" "Click to restart Steam at the new size" --exec ~/bin/steam-rescale --restart "$s"
	exit 0
fi
if pgrep -f 'SteamLaunch AppId=' >/dev/null; then
	omarchy-notification-send -u low "Steam not restarted" "A game is running"
	exit 0
fi
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/steam-rescale.lock"
flock -n 9 || exit 0 # one restart at a time: overlapping restarts left a Steam that wouldn't open
# Come back the way it was: in the tray if no Steam window was open
hyprctl clients -j | jq -e 'any(.class == "steam")' >/dev/null && silent= || silent=-silent
steam -shutdown >/dev/null 2>&1
for _ in $(seq 40); do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
# -shutdown is sometimes ignored; a launch while the old one lives just hands off to it and opens nothing
kill -0 "$pid" 2>/dev/null && kill "$pid" && for _ in $(seq 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
if kill -0 "$pid" 2>/dev/null; then
	omarchy-notification-send -u critical "Steam didn't close" "Couldn't restart it at the new UI scale"
	exit 1
fi
STEAM_FORCE_DESKTOPUI_SCALING="$s" setsid -f uwsm-app -- steam $silent >/dev/null 2>&1
