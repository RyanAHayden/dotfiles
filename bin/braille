#!/usr/bin/env python3
"""braille IMAGE [COLS] [CRUNCH] [--invert] — print an image as Unicode braille art.
CRUNCH = contrast boost, default 2 (1 = off)."""
import sys
from PIL import Image, ImageEnhance, ImageFilter, ImageOps

args = [a for a in sys.argv[1:] if a != "--invert"]
if not args:
    sys.exit(__doc__)
cols = int(args[1]) if len(args) > 1 else 60
crunch = float(args[2]) if len(args) > 2 else 2.0

im = Image.open(args[0]).convert("L")
w = cols * 2
h = max(4, round(im.height * w / im.width / 4) * 4)  # braille dots are ~square, no cell-aspect fix needed
im = im.resize((w, h), Image.LANCZOS)
if crunch > 1:
    im = ImageOps.equalize(im)  # spread tones so mid-greys separate
    im = im.filter(ImageFilter.UnsharpMask(radius=2, percent=int(100 * crunch), threshold=0))  # edges pop
    im = ImageEnhance.Contrast(im).enhance(crunch)  # push toward black/white, less dither mush
im = ImageOps.autocontrast(im)
if "--invert" not in sys.argv:
    im = ImageOps.invert(im)  # dark pixels -> dots; --invert lights the bright parts instead
px = im.convert("1").load()  # Floyd–Steinberg dither

BITS = ((0, 0, 0x01), (0, 1, 0x02), (0, 2, 0x04), (1, 0, 0x08),
        (1, 1, 0x10), (1, 2, 0x20), (0, 3, 0x40), (1, 3, 0x80))
for y in range(0, h, 4):
    print("".join(chr(0x2800 + sum(b for dx, dy, b in BITS if px[x + dx, y + dy]))
                  for x in range(0, w, 2)))
