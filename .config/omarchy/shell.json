{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.indicators",
          "items": [
            "Dnd",
            "Reminder",
            "NightLight",
            "StayAwake",
            "Dictation"
          ]
        },
        {
          "id": "focus-lock",
          "type": "command",
          "exec": "~/bin/bar-status.sh focus",
          "interval": 2,
          "onClick": "~/bin/toggle-focus-lock.sh"
        },
        {
          "id": "tv-mirror",
          "type": "command",
          "exec": "~/bin/bar-status.sh mirror",
          "interval": 2,
          "onClick": "~/bin/toggle-monitor-mirror.sh"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.power"
        },
        {
          "format": "dddd hh:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "hh\n—\nmm\nAP"
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [],
  "version": 1,
  "disabledPlugins": [
    "omarchy.battery",
    "omarchy.wifiqr"
  ]
}
